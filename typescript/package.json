{
  "name": "webpack-typescript-boilerplate",
  "version": "1.0.0",
  "description": "Webpack TypeScript Boilerplate",
  "main": "src/scripts/main.ts",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Denis Axenov",
  "license": "MIT",
  "homepage": "https://github.com/denis-axenov/webpack-boilerplates/tree/main/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denis-axenov/webpack-boilerplates.git"
  },
  "scripts": {
    "dev": "webpack serve --mode=development",
    "dev:lint": "webpack serve --mode=development --env lint",
    "watch": "webpack --mode=development --watch",
    "watch:lint": "webpack --mode=development --watch --env lint",
    "build": "webpack --mode=production",
    "build:lint": "webpack --mode=production --env lint",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "stylelint": "stylelint src",
    "stylelint:fix": "stylelint src --fix",
    "lint": "eslint && stylelint src",
    "lint:fix": "eslint --fix && stylelint src --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --collect-coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/eslint": "^9.6.1",
    "@types/eslint__js": "^9.14.0",
    "@types/jest": "^30.0.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.1.1",
    "eslint": "^9.37.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-webpack-plugin": "^5.0.2",
    "globals": "^16.4.0",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^10.4.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-webpack-plugin": "^5.0.1",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
