{
  "name": "webpack-basic-boilerplate",
  "version": "1.0.0",
  "description": "Webpack Basic Boilerplate",
  "main": "src/scripts/main.js",
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "author": "Denis Axenov",
  "license": "MIT",
  "homepage": "https://github.com/denis-axenov/webpack-boilerplates/tree/main/basic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denis-axenov/webpack-boilerplates.git"
  },
  "scripts": {
    "dev": "nodemon --exec \"webpack serve --mode=development\"",
    "dev:lint": "nodemon --exec \"webpack serve --mode=development --env lint\"",
    "watch": "nodemon --exec \"webpack --mode=development --watch\"",
    "watch:lint": "nodemon --exec \"webpack --mode=development --watch --env lint\"",
    "build": "webpack --mode=production",
    "build:lint": "webpack --mode=production --env lint",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "stylelint": "stylelint src",
    "stylelint:fix": "stylelint src --fix",
    "lint": "eslint && stylelint src",
    "lint:fix": "eslint --fix && stylelint src --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --collect-coverage"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.15.41",
    "@swc/jest": "^0.2.39",
    "css-loader": "^7.1.4",
    "cssnano": "^8.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-webpack-plugin": "^6.0.0",
    "globals": "^17.6.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.15",
    "postcss-html": "^1.8.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.3.1",
    "postcss-scss": "^4.0.9",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-webpack-plugin": "^5.1.0",
    "swc-loader": "^0.2.7",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5"
  }
}
