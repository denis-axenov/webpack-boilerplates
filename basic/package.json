{
  "name": "webpack-basic-boilerplate",
  "version": "1.0.0",
  "description": "Webpack Basic Boilerplate",
  "main": "src/scripts/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Denis Axenov",
  "license": "MIT",
  "homepage": "https://github.com/denis-axenov/webpack-boilerplate/tree/main/basic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denis-axenov/webpack-boilerplates.git"
  },
  "scripts": {
    "dev": "webpack serve --mode=development",
    "dev:lint": "webpack serve --mode=development --env lint",
    "watch": "webpack --mode=development --watch",
    "watch:lint": "webpack --mode=development --watch --env lint",
    "build": "webpack --mode=production",
    "build:lint": "webpack --mode=production --env lint",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "stylelint": "stylelint src",
    "stylelint:fix": "stylelint src --fix",
    "lint": "eslint && stylelint src",
    "lint:fix": "eslint --fix && stylelint src --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --collect-coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@jest/globals": "^29.7.0",
    "@swc/core": "^1.10.9",
    "@swc/jest": "^0.2.37",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.6",
    "eslint": "^9.19.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-webpack-plugin": "^4.2.0",
    "globals": "^15.14.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-alpha.6",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.1",
    "postcss-html": "^1.8.0",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.1.3",
    "postcss-scss": "^4.0.9",
    "sass": "^1.83.4",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "stylelint": "^16.14.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-webpack-plugin": "^5.0.1",
    "swc-loader": "^0.2.6",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
